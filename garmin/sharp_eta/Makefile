# SHARP ETA Connect IQ app. Needs the Connect IQ SDK (installed with Garmin's
# SDK Manager, which records the current SDK in current-sdk.cfg) plus the
# fr165 device files, and a developer key (`make key`, once).

CIQ_HOME ?= $(HOME)/Library/Application Support/Garmin/ConnectIQ
# The SDK Manager records the current SDK; otherwise use monkeyc on PATH
# (e.g. `brew install --cask connectiq`).
SDK ?= $(or $(shell cat "$(CIQ_HOME)/current-sdk.cfg" 2>/dev/null),$(patsubst %/bin/monkeyc,%,$(realpath $(shell command -v monkeyc 2>/dev/null))))
DEVICE ?= fr165
DEV_KEY ?= ../developer_key.der
# Server for debug builds when no URL is set in the app's settings.
SERVER ?= http://localhost:8090

MONKEYC = "$(SDK)/bin/monkeyc"
MONKEYDO = "$(SDK)/bin/monkeydo"
SOURCES = manifest.xml monkey.jungle gen/DebugServer.mc $(shell find source resources -type f)

.PHONY: build release test sim simulator key check-sdk FORCE

check-sdk:
	@test -n "$(SDK)" -a -x "$(SDK)/bin/monkeyc" || { \
	  echo "Connect IQ SDK not found (looked in $(CIQ_HOME)/current-sdk.cfg)."; \
	  echo "Install it with Garmin's SDK Manager, or run: make SDK=/path/to/sdk ..."; exit 1; }
	@test -f "$(DEV_KEY)" || { echo "No developer key at $(DEV_KEY): run make key"; exit 1; }

# Rewritten only when SERVER changes, so builds stay incremental.
gen/DebugServer.mc: FORCE
	@mkdir -p gen
	@printf '%s\n' '// Generated by the Makefile (SERVER=$(SERVER)); not in git.' \
	  '(:debug) const DEBUG_SERVER_URL = "$(SERVER)";' \
	  '(:release) const DEBUG_SERVER_URL = "";' > gen/DebugServer.mc.new
	@cmp -s gen/DebugServer.mc.new $@ && rm gen/DebugServer.mc.new || mv gen/DebugServer.mc.new $@
FORCE:

# Debug build: uses $(SERVER) when no server URL is set.
bin/sharp_eta.prg: $(SOURCES) | check-sdk
	@mkdir -p bin
	$(MONKEYC) -d $(DEVICE) -f monkey.jungle -o $@ -y "$(DEV_KEY)" -w

build: bin/sharp_eta.prg

# Release build for sideloading (no debug server fallback).
release: $(SOURCES) | check-sdk
	@mkdir -p bin
	$(MONKEYC) -d $(DEVICE) -f monkey.jungle -o bin/sharp_eta_release.prg -y "$(DEV_KEY)" -r -w

# Start the Connect IQ simulator unless it is already running (matched by its
# app path: a bare "simulator" pattern matches unrelated processes).
simulator:
	@pgrep -qf "ConnectIQ.app/Contents/MacOS" || { open "$(SDK)/bin/ConnectIQ.app"; sleep 8; }

# Unit tests (source/test/) run inside the simulator.
test: $(SOURCES) | check-sdk simulator
	@mkdir -p bin
	$(MONKEYC) -d $(DEVICE) -f monkey.jungle -o bin/sharp_eta_test.prg -y "$(DEV_KEY)" -t -w
	@# monkeydo -t exits 1 even when every test passes: judge by the summary line.
	@$(MONKEYDO) bin/sharp_eta_test.prg $(DEVICE) -t | tee bin/test.log; grep -q "^PASSED" bin/test.log

# Run the app in the simulator (start the tracker on :8090 first).
sim: bin/sharp_eta.prg simulator
	$(MONKEYDO) bin/sharp_eta.prg $(DEVICE)

# One-time developer key, kept out of git (garmin/.gitignore).
key:
	@test ! -f "$(DEV_KEY)" || { echo "$(DEV_KEY) already exists"; exit 1; }
	openssl genrsa -out "$(DEV_KEY:.der=.pem)" 4096
	openssl pkcs8 -topk8 -inform PEM -outform DER -in "$(DEV_KEY:.der=.pem)" -out "$(DEV_KEY)" -nocrypt
