# NMEA source: tcp or serial. If NMEA_SERIAL_PORT is set, source defaults to serial.
NMEA_SOURCE=tcp

# TCP NMEA source
NMEA_HOST=192.168.20.215
NMEA_PORT=4000

# Serial NMEA source examples:
# macOS: /dev/tty.usbserial-XXXX or /dev/tty.usbmodemXXXX
# Linux/Raspberry Pi: /dev/ttyUSB0, /dev/ttyACM0, or /dev/ttyAMA0
# NMEA_SERIAL_PORT=/dev/ttyUSB0
# NMEA_SERIAL_BAUD=4800
# NMEA_SERIAL_TIMEOUT=5

# Local default. On Railway, attach Postgres and Railway will provide DATABASE_URL.
DATABASE_PATH=data/positions.sqlite3
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# When set, collector POSTs to this API instead of writing directly to DB.
# Local API:
# TRACKER_API_URL=http://127.0.0.1:8000
# Railway API:
# TRACKER_API_URL=https://your-ingest-service.up.railway.app

# Optional shared secret. Set the same value on collector and API.
# TRACKER_INGEST_TOKEN=change-me

LOG_LEVEL=INFO
