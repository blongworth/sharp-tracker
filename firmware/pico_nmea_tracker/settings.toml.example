# Copy to settings.toml on the CIRCUITPY drive and fill in real values.
# CircuitPython reads this file into os.getenv() at boot; it is not committed
# to git (see repo .gitignore).

CIRCUITPY_WIFI_SSID = "ship-wifi"
CIRCUITPY_WIFI_PASSWORD = "change-me"

# Same ingest API the desktop collector posts to (sharp_tracker.api).
TRACKER_API_URL = "https://your-ingest-service.up.railway.app"
TRACKER_INGEST_TOKEN = "change-me"

# NMEA source wired to UART0 RX (GP1). 4800 is the common NMEA default;
# some AIS/GPS units use 38400.
NMEA_SERIAL_BAUD = "4800"

# Average 1 Hz fixes into UTC-aligned windows (seconds); one fix sent per
# window. 0 sends every fix (RAM and bandwidth use ~120x higher).
AVERAGE_SECONDS = "60"

# Batching: flush whichever comes first.
BATCH_SIZE = "20"
FLUSH_SECONDS = "5"

# Unsent fixes kept in RAM while the server is unreachable (500 one-minute
# averages is about 8 hours); oldest dropped beyond this, or sooner if free memory
# falls below MIN_FREE_BYTES. Lost on reboot or power loss.
MAX_BUFFER = "500"
MIN_FREE_BYTES = "30000"

# Console status line (GPS, network, clock, memory) every this many seconds;
# 0 disables. The onboard LED shows the same state as a blink code (README).
STATUS_SECONDS = "60"

# Reboot if the main loop hangs this long (RP2040 max ~8.3 s); 0 disables.
WATCHDOG_SECONDS = "8"
